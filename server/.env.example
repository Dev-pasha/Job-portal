# Copy this file to .env and change the values before deploying.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Local:  postgresql://USER:PASSWORD@localhost:5432/jobportal
# Hosted: use the string your provider gives you, and set PGSSL=true
DATABASE_URL=postgresql://postgres:1234@localhost:5432/jobportal
PGSSL=false

# Used to sign admin login tokens. Any long random string.
JWT_SECRET=replace-this-with-a-long-random-string

# The admin account created by `npm run seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
